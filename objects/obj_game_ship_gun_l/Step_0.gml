// Referencia a la nave que porta el arma (asígnasela al crearla)
owner = obj_game_ship; 

// Distancia en píxeles desde el centro (origen) de la nave al anclaje
offset_dist = 24; 

// Ángulo relativo:
// 0 = adelante (morro)
// 90 = ala izquierda
// -90 o 270 = ala derecha
// 180 = parte trasera
offset_angle = 60;